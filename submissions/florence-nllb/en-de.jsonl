{"doc_id":"doc_009","regions":[{"region_id":"p0","bbox":[96.47500610351562,61.05000305175781,282.20001220703125,25.29999542236328],"text":"Wohnvermietungsvereinbarung","reading_order":0},{"region_id":"p1","bbox":[98.17500305175781,141.35000610351562,260.1000213623047,18.699996948242188],"text":"Klausel 4 - Miet- und Zahlungsbedingungen","reading_order":1},{"region_id":"p2","bbox":[98.17500305175781,200.75,751.4000091552734,16.5],"text":"Der Mieter zahlt dem Vermieter eine monatliche Miete in Höhe von 1 450 EUR (1 450 EUR), die im Voraus am","reading_order":2},{"region_id":"p3","bbox":[96.47500610351562,340.45001220703125,653.6499938964844,17.600006103515625],"text":"Die Verzögerung der Zahlung von Finanzmitteln über fünf (3) Tage bedarf einer Strafe von zwei Prozent (2%) der monatlichen Miete pro Verzögerungswoche.","reading_order":3},{"region_id":"p4","bbox":[96.47500610351562,461.45001220703125,605.2000427246094,15.399993896484375],"text":"Die Miete wird durch Banküberweisung auf das vom Landlord benannte Konto bezahlt.","reading_order":4},{"region_id":"p5","bbox":[96.47500610351562,580.25,187.0,17.60003662109375],"text":"Unterzeichnet in Paris am 14. April 2026.","reading_order":5}],"output_file":null,"runtime_seconds":76.90833449363708}
