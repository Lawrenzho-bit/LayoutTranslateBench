{"doc_id":"doc_009","regions":[{"region_id":"p0","bbox":[96.47500610351562,61.05000305175781,282.20001220703125,25.29999542236328],"text":"Perjanjian Penyewaan Perumahan","reading_order":0},{"region_id":"p1","bbox":[98.17500305175781,141.35000610351562,260.1000213623047,18.699996948242188],"text":"Klausa 4 - Syarat sewa dan pembayaran","reading_order":1},{"region_id":"p2","bbox":[98.17500305175781,200.75,751.4000091552734,16.5],"text":"Penyewa harus membayar kepada tuan tanah sewa bulanan sebanyak EUR 1,450 (satu ribu empat ratus lima puluh euro), yang dibayar terlebih dahulu pada atau pada","reading_order":2},{"region_id":"p3","bbox":[96.47500610351562,340.45001220703125,653.6499938964844,17.600006103515625],"text":"Pembayaran kewangan terlambat lebih daripada lima (3) hari akan dikenakan denda dua peratus (2%) daripada sewa bulanan setiap minggu penundaan.","reading_order":3},{"region_id":"p4","bbox":[96.47500610351562,461.45001220703125,605.2000427246094,15.399993896484375],"text":"Penyewaan hendaklah dibayar dengan transfer bank ke akaun yang ditetapkan oleh LandLord. Pembayaran tunai tidak diterima.","reading_order":4},{"region_id":"p5","bbox":[96.47500610351562,580.25,187.0,17.60003662109375],"text":"Ditandatangani di Paris pada 14 April 2026.","reading_order":5}],"output_file":null,"runtime_seconds":65.48447036743164}
