{"doc_id":"doc_003","regions":[{"region_id":"r1","bbox":[100.0,80.0,650.0,60.0],"text":"On the asymptotic behavior of large language models","reading_order":0},{"region_id":"r2","bbox":[100.0,160.0,650.0,30.0],"text":"Jane Smith, John Doe","reading_order":1},{"region_id":"r3","bbox":[100.0,230.0,650.0,30.0],"text":"Abstract","reading_order":2},{"region_id":"r4","bbox":[100.0,270.0,650.0,100.0],"text":"We study the scaling behavior of transformer-based language models as parameter count grows. Our results suggest a power-law relationship between loss and compute.","reading_order":3},{"region_id":"r5","bbox":[100.0,400.0,320.0,30.0],"text":"1. Introduction","reading_order":4},{"region_id":"r6","bbox":[100.0,440.0,320.0,280.0],"text":"Recent work has shown that language model performance follows predictable scaling laws across orders of magnitude in compute.","reading_order":5},{"region_id":"r7","bbox":[430.0,440.0,320.0,280.0],"text":"In this paper we extend these results to the trillion-parameter regime and examine whether the scaling exponent remains stable.","reading_order":6},{"region_id":"r8","bbox":[100.0,760.0,650.0,50.0],"text":"Figure 1. Loss as a function of training compute (log-log).","reading_order":7}],"output_file":null,"runtime_seconds":null}
