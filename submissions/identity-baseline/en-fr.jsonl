{"doc_id":"doc_009","regions":[{"region_id":"r1","bbox":[100.0,60.0,650.0,50.0],"text":"Residential Lease Agreement","reading_order":0},{"region_id":"r2","bbox":[100.0,140.0,650.0,30.0],"text":"Clause 4 — Rent and Payment Terms","reading_order":1},{"region_id":"r3","bbox":[100.0,200.0,650.0,120.0],"text":"The Tenant shall pay to the Landlord a monthly rent of EUR 1,450 (one thousand four hundred and fifty euros), payable in advance on or before the first day of each calendar month, without demand or notice.","reading_order":2},{"region_id":"r4","bbox":[100.0,340.0,650.0,100.0],"text":"Late payments of more than five (5) days shall incur a penalty of two percent (2%) of the monthly rent per week of delay.","reading_order":3},{"region_id":"r5","bbox":[100.0,460.0,650.0,80.0],"text":"Rent shall be paid by bank transfer to the account designated by the Landlord. Cash payments are not accepted.","reading_order":4},{"region_id":"r6","bbox":[100.0,580.0,650.0,40.0],"text":"Signed at Paris on 14 April 2026.","reading_order":5}],"output_file":null,"runtime_seconds":null}
{"doc_id":"doc_010","regions":[{"region_id":"r1","bbox":[50.0,50.0,700.0,50.0],"text":"Public Health Advisory","reading_order":0},{"region_id":"r2","bbox":[50.0,130.0,700.0,40.0],"text":"Issued by the Ministry of Health — 5 May 2026","reading_order":1},{"region_id":"r3","bbox":[50.0,200.0,700.0,30.0],"text":"Subject: Seasonal Influenza Vaccination Programme","reading_order":2},{"region_id":"r4","bbox":[50.0,260.0,700.0,120.0],"text":"All residents aged 65 and above, and those with chronic medical conditions, are strongly encouraged to receive the seasonal influenza vaccine.","reading_order":3},{"region_id":"r5","bbox":[50.0,400.0,700.0,80.0],"text":"Free vaccinations are available at all government polyclinics and participating general practitioners until 30 June 2026.","reading_order":4},{"region_id":"r6","bbox":[50.0,500.0,700.0,60.0],"text":"For appointments and further information, please call 1800-HEALTH or visit www.health.gov.sg","reading_order":5}],"output_file":null,"runtime_seconds":null}
